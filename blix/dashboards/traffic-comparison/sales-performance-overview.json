{
  "visualisation": {
    "title": " ",
    "description": "Traffic Comparison",
    "type": "Table",
    "tableSettings": {
      "scrollOverflow": true
    }
  },
  "columnNames": [
    "Location",
    "Walkby Trend",
    "Traffic",
    { "name": "traffic-vs", "displayName": "vs" },
    "Dwell Time",
    { "name": "dwell-time-vs", "displayName": "vs" },
    "Missed Opportunities",
    { "name": "missed-opportunities-vs", "displayName": "vs" }
  ],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "key": "venueId"
          }
        },
        {
          "description": "Outside Traffic Trend",
          "decimalPlaces": 1,
          "unit": "percentage",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "metric": "BlixWalkby",
                    "value": {
                      "counter": "total"
                    }
                  },
                  {
                    "metric": "BlixWalkby",
                    "value": {
                      "counter": "total"
                    },

                    "dateRangeOverride": {
                      "localStartDate": {
                        "paramRef": "SecondaryStartDate"
                      },
                      "localEndDate": {
                        "paramRef": "SecondaryEndDate"
                      }
                    }
                  }
                ]
              },
              1.0
            ]
          }
        },
        {
          "description": "Traffic",
          "numericExpression": {
            "metric": "BlixVisit",
            "value": {
              "counter": "total"
            }
          },
          "sortSpecification": {
            "ascending": false,
            "priority": 1
          }
        },
        {
          "description": "Traffic vs",
          "decimalPlaces": 1,
          "unit": "percentage",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "metric": "BlixVisit",
                    "value": {
                      "counter": "total"
                    }
                  },
                  {
                    "metric": "BlixVisit",
                    "value": {
                      "counter": "total"
                    },

                    "dateRangeOverride": {
                      "localStartDate": {
                        "paramRef": "SecondaryStartDate"
                      },
                      "localEndDate": {
                        "paramRef": "SecondaryEndDate"
                      }
                    }
                  }
                ]
              },
              1.0
            ]
          }
        },
        {
          "description": "(Average) Dwell Time (seconds) (total dwell / traffic)",
          "numericExpression": {
            "$divide": [
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "dwell"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "decimalPlaces": 0,
          "unit": "duration"
        },
        {
          "description": "Dwell Time vs",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "$divide": [
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "dwell"
                        }
                      },
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        }
                      }
                    ]
                  },
                  {
                    "$divide": [
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "dwell"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      },
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              1.0
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        },
        {
          "description": "Missed Opportunities",
          "numericExpression": {
            "$divide": [
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                },
                "segment": {
                  "dimension": "BOUNCE",
                  "segment": "bounce"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "decimalPlaces": 2,
          "unit": "percentage"
        },
        {
          "description": "Missed opportunities vs",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "$divide": [
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        },
                        "segment": {
                          "dimension": "BOUNCE",
                          "segment": "bounce"
                        }
                      },
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        }
                      }
                    ]
                  },
                  {
                    "$divide": [
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        },
                        "segment": {
                          "dimension": "BOUNCE",
                          "segment": "bounce"
                        },
                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      },
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              1.0
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        }
      ]
    }
  ]
}
