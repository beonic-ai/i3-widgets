{
  "visualisation": {
    "title": " ",
    "description": "Overview",
    "type": "Table",
    "tableSettings": {
      "scrollOverflow": true
    }
  },
  "columnNames": [
    "Store",
    "Sales",
    "Traffic",
    "vs",
    "Sales conversion",
    "vs2",
    "ATV",
    "vs3",
    "IPT",
    "vs4",
    "$ per Traffic",
    "Did Not Buy",
    "Sales Productivity (tbd)",
    "% Hours to Optimise (tbd)",
    "Missed Opportunities (tbd)",
    "Dwell Time"
  ],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "key": "venueId"
          }
        },
        {
          "description": "Sales",
          "numericExpression": {
            "metric": 285,
            "value": {
              "counter": "Revenue"
            }
          },
          "unit": "dollars",
          "decimalPlaces": 2,
          "sortSpecification": {
            "ascending": false,
            "priority": 1
          }
        },
        {
          "description": "Traffic",
          "numericExpression": {
            "metric": "BlixVisit",
            "value": {
              "counter": "total"
            }
          }
        },
        {
          "description": "Traffic vs",
          "decimalPlaces": 1,
          "unit": "percentage",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "metric": "BlixVisit",
                    "value": {
                      "counter": "total"
                    }
                  },
                  {
                    "metric": "BlixVisit",
                    "value": {
                      "counter": "total"
                    },

                    "dateRangeOverride": {
                      "localStartDate": {
                        "paramRef": "SecondaryStartDate"
                      },
                      "localEndDate": {
                        "paramRef": "SecondaryEndDate"
                      }
                    }
                  }
                ]
              },
              1.0
            ]
          }
        },
        {
          "description": "Sales Conversion (transactions / traffic)",
          "numericExpression": {
            "$divide": [
              {
                "metric": 285,
                "value": {
                  "counter": "Transactions"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        },
        {
          "description": "Sales Conversion Versus",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "$divide": [
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Transactions"
                        }
                      },
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        }
                      }
                    ]
                  },
                  {
                    "$divide": [
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Transactions"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      },
                      {
                        "metric": "BlixVisit",
                        "value": {
                          "counter": "total"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              1.0
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        },
        {
          "description": "ATV (Sales / Transactions)",
          "numericExpression": {
            "$divide": [
              {
                "metric": 285,
                "value": {
                  "counter": "Revenue"
                }
              },
              {
                "metric": 285,
                "value": {
                  "counter": "Transactions"
                }
              }
            ]
          },
          "unit": "dollars",
          "decimalPlaces": 0
        },
        {
          "description": "ATV Versus",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "$divide": [
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Revenue"
                        }
                      },
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Transactions"
                        }
                      }
                    ]
                  },
                  {
                    "$divide": [
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Revenue"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      },
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Transactions"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              1.0
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        },
        {
          "description": "IPT (Items / Transactions)",
          "numericExpression": {
            "$divide": [
              {
                "metric": 285,
                "value": {
                  "counter": "Items"
                }
              },
              {
                "metric": 285,
                "value": {
                  "counter": "Transactions"
                }
              }
            ]
          },
          "decimalPlaces": 1
        },
        {
          "description": "IPT vs",
          "numericExpression": {
            "$subtract": [
              {
                "$divide": [
                  {
                    "$divide": [
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Items"
                        }
                      },
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Transactions"
                        }
                      }
                    ]
                  },
                  {
                    "$divide": [
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Items"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      },
                      {
                        "metric": 285,
                        "value": {
                          "counter": "Transactions"
                        },

                        "dateRangeOverride": {
                          "localStartDate": {
                            "paramRef": "SecondaryStartDate"
                          },
                          "localEndDate": {
                            "paramRef": "SecondaryEndDate"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              1.0
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        },
        {
          "description": "$ / Traffic (revenue / visits)",
          "numericExpression": {
            "$divide": [
              {
                "metric": 285,
                "value": {
                  "counter": "Revenue"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "unit": "dollars",
          "decimalPlaces": 0
        },
        {
          "description": "Did Not Buy (Traffic - Transactions)",
          "numericExpression": {
            "$subtract": [
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              },
              {
                "metric": 285,
                "value": {
                  "counter": "Transactions"
                }
              }
            ]
          },
          "decimalPlaces": 0
        },
        {
          "description": "Sales Productivity",
          "numericExpression": 0
        },
        {
          "description": "% Hours to Optimise",
          "numericExpression": 0
        },
        {
          "description": "Missed Opportunities",
          "numericExpression": 0
        },
        {
          "description": "(Average) Dwell Time (seconds) (total dwell / traffic)",
          "numericExpression": {
            "$divide": [
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "dwell"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "decimalPlaces": 0,
          "unit": "duration"
        }
      ]
    }
  ]
}
