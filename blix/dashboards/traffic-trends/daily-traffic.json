{
  "visualisation": {
    "title": "Daily Traffic",
    "description": "Shows the traffic by day for the period.",
    "type": "LineChart",
    "lineChartSettings": {
      "gridLines": "always",
      "showLegend": true,
      "columnSettings": {
        "Traffic": {
          "axis": "right"
        }
      }
    }
  },
  "columnNames": ["date", "Location", "Traffic"],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "timeBasedDimension": "Daily"
          }
        },
        {
          "dimension": {
            "key": "venueId"
          }
        },
        {
          "numericExpression": {
            "metric": "BlixVisit",
            "value": {
              "counter": "total"
            },
            "unit": "number"
          }
        }
      ]
    }
  ]
}
