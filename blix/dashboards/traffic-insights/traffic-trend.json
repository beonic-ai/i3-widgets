{
  "visualisation": {
    "title": "Traffic Trend",
    "description": "Shows the traffic by day for the period.",
    "type": "MultiChart",
    "multiChartSettings": {
      "gridLines": "always",
      "showLegend": true,
      "palette": "red",
      "showBarValues": true,
      "columnSettings": {
        "Traffic": {
          "axis": "left",
          "type": "bar"
        },
        "OutsideTraffic": {
          "axis": "right",
          "type": "line"
        }
      }
    }
  },
  "columnNames": ["date", "Traffic", "OutsideTraffic"],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "timeBasedDimension": "Daily"
          }
        },
        {
          "numericExpression": {
            "metric": "BlixVisit",
            "value": {
              "counter": "total"
            }
          }
        },
        {
          "numericExpression": {
            "metric": "BlixWalkby",
            "value": {
              "counter": "total"
            },
            "unit": "number"
          }
        }
      ]
    }
  ]
}
