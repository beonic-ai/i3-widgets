{
  "visualisation": {
    "type": "BarChart",
    "title": "Missed Opportunities",
    "description": "Missed opportunities (bounces / visits) per day of the week for the period.",
    "barChartSettings": {
      "showLegend": false,
      "gridLines": "always"
    }
  },
  "columnNames": ["date", "Bounce"],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "timeBasedDimension": "DayOfWeek",
            "format": "Short"
          }
        },
        {
          "description": "Missed Opportunities",
          "numericExpression": {
            "$divide": [
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                },
                "segment": {
                  "dimension": "BOUNCE",
                  "segment": "bounce"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "decimalPlaces": 2,
          "unit": "percentage"
        }
      ]
    }
  ]
}
