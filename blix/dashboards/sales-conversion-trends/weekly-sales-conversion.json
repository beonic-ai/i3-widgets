{
  "visualisation": {
    "title": "Weekly Sales Conversion",
    "description": "Sales Conversion for each week of the period compared to the week in the previous period.",
    "type": "BarChart",
    "barChartSettings": {
      "gridLines": "always",
      "showLegend": true,
      "leftAxis": {
        "minValue": "auto",
        "maxValue": "auto"
      }
    }
  },
  "columnNames": ["date", "Sales Conversion", "Sales Conversion Previous"],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "timeBasedDimension": "Weekly"
          }
        },
        {
          "description": "Sales Conversion (transactions / traffic)",
          "numericExpression": {
            "$divide": [
              {
                "metric": {
                  "customMetricName": "Sales"
                },
                "value": {
                  "counter": "Transactions"
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                }
              }
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        },
        {
          "description": "Sales Conversion Previous period",
          "numericExpression": {
            "$divide": [
              {
                "metric": {
                  "customMetricName": "Sales"
                },
                "value": {
                  "counter": "Transactions"
                },

                "dateRangeOverride": {
                  "localStartDate": {
                    "paramRef": "SecondaryStartDate"
                  },
                  "localEndDate": {
                    "paramRef": "SecondaryEndDate"
                  }
                }
              },
              {
                "metric": "BlixVisit",
                "value": {
                  "counter": "total"
                },

                "dateRangeOverride": {
                  "localStartDate": {
                    "paramRef": "SecondaryStartDate"
                  },
                  "localEndDate": {
                    "paramRef": "SecondaryEndDate"
                  }
                }
              }
            ]
          },
          "unit": "percentage",
          "decimalPlaces": 1
        }
      ]
    }
  ]
}
