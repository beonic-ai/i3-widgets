{
  "visualisation": {
    "title": "Weekly Traffic and Sales",
    "description": "Weekly traffic and sales over the period.",
    "type": "MultiChart",
    "multiChartSettings": {
      "gridLines": "always",
      "showLegend": true,
      "palette": "red",
      "columnSettings": {
        "Traffic": { "axis": "left", "type": "bar" },
        "Sales": { "axis": "right", "type": "line" }
      }
    }
  },
  "columnNames": ["timestamp", "Traffic", "Sales"],
  "rowSets": [
    {
      "columns": [
        {
          "dimension": {
            "timeBasedDimension": "Weekly"
          }
        },
        {
          "description": "Traffic",
          "numericExpression": {
            "metric": "BlixVisit",
            "value": {
              "counter": "total"
            }
          },
          "decimalPlaces": 0
        },
        {
          "numericExpression": {
            "metric": {
              "customMetricName": "Sales"
            },
            "value": {
              "counter": "Revenue"
            }
          }
        }
      ]
    }
  ]
}
